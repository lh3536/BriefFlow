# AO Agent（理解用户输入 + 输出整合）的可选 LLM 配置。
# 复制本文件为 .env 并填入真实 Key；.env 已在 .gitignore 中，绝不提交。
# 不配置 = 自动使用内置规则解析，全流程照常运行。

# 必填：OpenAI 兼容 API 的 Key（不填则 LLM 增强关闭）
BRIEF_LLM_API_KEY=

# 可选：OpenAI 兼容接口地址（默认 https://api.openai.com/v1）
BRIEF_LLM_BASE_URL=https://api.openai.com/v1

# 可选：模型名（默认 gpt-4o-mini）
BRIEF_LLM_MODEL=gpt-4o-mini

# 可选：单次请求超时秒数（默认 8；超时/报错会自动回退规则路径）
BRIEF_LLM_TIMEOUT=8
