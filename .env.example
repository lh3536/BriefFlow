# AO Agent（理解用户输入 + 输出整合）的可选 LLM 配置。
# 复制本文件为 .env 并填入真实 Key；.env 已在 .gitignore 中，绝不提交。
# 不配置 = 自动使用内置规则解析，全流程照常运行。

# 必填：DashScope API Key（不填则 LLM 增强关闭，禁止提交真实 Key）
BRIEF_LLM_API_KEY=

# 可选：沿用 OpenAI-compatible 协议，默认 Qwen 官方端点
BRIEF_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：模型名
BRIEF_LLM_MODEL=qwen-plus

# 可选：单次请求超时秒数（默认 30；超时/报错会自动回退规则路径）
BRIEF_LLM_TIMEOUT=30

# 可选：temperature（默认不传；kimi-k2.6 等模型只接受 1，传 0 会报 400）
# BRIEF_LLM_TEMPERATURE=1

# 检索来源模式：mock（默认，演示数据）/ database（SQLite 缓存）/ web（真实公开来源抓取）
# web 模式会联网抓取公开来源（UKRI / 挑战杯 / 中金所杯 / 港交所 / 澳门新闻局 / 香港证监会），
# 抓取失败或无结果时自动回退 mock，并在页面显示回退警告。
BRIEFFLOW_RETRIEVAL_MODE=mock
